// basic - Bare essentials for Ki programming.
// https://github.com/notjoshki/ki-v3

import system;
export #io, #memory, #strings, #debugging, #math;

// 17 pages of 4KiB = 65 Kib, 16 pages for data and 1 for the guard page.
HEAP_SIZE: const 65536;
GUARD_PAGE_SIZE: const 4096;

EXIT_SUCCESS: const 0;
EXIT_FAILURE: const 1;

INT_BUFFER_CAPACITY: const 33;
STRING_CAPACITY: const 16;

//FLOAT_EPSILON_TOLERANCE: const 0.000001;

#memory
byte: alias u8;

#io
File: alias i32;

// Heap definitions.
asm("section .data\n_ki_heap: dq 0\n_ki_heap_ptr: dq 0\n_ki_heap_free_list: dq 0\nsection .text");

// Print a string to standard output.
#io
print(str: &string) {
    system.write(system.STDOUT, str.data, str.length);
}

// Print a character to standard output.
#io
print_char(c: char) {
    system.write(system.STDOUT, &c, 1);
}

// Print a string and a newline to standard output.
#io
println(str: &string) {
    c: char = 10;
    system.write(system.STDOUT, str.data, str.length);
    system.write(system.STDOUT, &c, 1);
}

// Format a string and print it.
#io
print_format(format: &string, s1: &string = null, s2: &string = null, s3: &string = null, s4: &string = null) {
    total_len := format.length;

    if s1 != null {
        total_len += s1.length;
    } else {
        print(format);
        return;
    }

    if s2 != null {
        total_len += s2.length;
    }

    if s3 != null {
        total_len += s3.length;
    }

    if s4 != null {
        total_len += s4.length;
    }

    str := new_string(total_len);
    format_string(str, format, s1, s2, s3, s4);
    print(str);
    delete_string(str);
}

// Receive a line of input from standard input. Returns the number of characters read.
#io
scan(buffer: &char, capacity: usize, strip_newline: bool = true): usize {
    chars_read := system.read(system.STDIN, buffer, capacity);

    if chars_read < 0 {
        return 0;
    }

    if strip_newline && chars_read > 0 {
        buffer[chars_read - 1] = '\0';
        buffer[chars_read] = '\0';
        return chars_read - 1;
    }

    buffer[chars_read] = '\0';
    return chars_read;
}

// Receive a line of input from standard input without using a buffer, return a new string.
#io
input(message: &string = null, capacity: usize = 255, strip_newline: bool = true): &string {
    if message != null {
        print(message);
    }

    str := new_string(capacity);
    str.length = scan(str.data, capacity, strip_newline);
    return str;
}

// Copy a number of bytes from one pointer to another.
#memory
copy_bytes(destination: &byte, source: &byte, count: usize) {
    for i := 0..count {
        destination[i] = source[i];
    }
}

// Set the value of a number of bytes in a pointer.
#memory
set_bytes(destination: &byte, value: byte, count: usize) {
    for i := 0..count {
        destination[i] = value;
    }
}

// Compare the values of bytes between two pointers.
#memory
compare_bytes(destination: &byte, source: &byte, count: usize): usize {
    same: usize = 0;

    for i := 0..count {
        if destination[i] == source[i] {
            same += 1;
        }
    }

    return same;
}

// Allocates a new string.
#strings
new_string(capacity: usize = STRING_CAPACITY): &string {
    new_capacity: usize = STRING_CAPACITY;

    while capacity > new_capacity {
        new_capacity *= 2;
    }

    str: &string = alloc(sizeof(string));
    str.data = alloc(new_capacity + 1);
    str.length = 0;
    str.capacity = new_capacity;
    return str;
}

// Frees a string from the heap 
#strings
delete_string(str: &string) {
    free(str.data);
    free(str);
}

// Allocate a new string and copy the characters from another string into it.
#strings
copy_string(str: &string): &string {
    new: &string = new_string(str.capacity);
    assign_string(new, str);
    return new;
}

// Allocate a new string and copy the characters from a range within another string into it.
#strings
copy_string_slice(str: &string, start: usize, end: usize): &string {
    if start >= str.length || end < start {
        return new_string(0);
    }

    diff := end - start;
    new: &string = new_string(diff);
    copy_bytes(new.data, cast(&char str.data + start), diff);

    new.length = diff;
    new.data[diff] = '\0';
    return new;
}

// Compare the lengths and characters of two strings.
#strings
compare_string(lhs: &string, rhs: &string): bool {
    if lhs.length != rhs.length {
        return 0;
    }

    return compare_bytes(lhs.data, rhs.data, lhs.length) == lhs.length;
}

// Allocate additional memory to a string if needed to allow more data to be inserted.
#strings
reserve_string(str: &string, new_length: usize) {
    if str.capacity >= new_length {
        return;
    }

    new_capacity: usize = STRING_CAPACITY;

    while new_length > new_capacity {
        new_capacity *= 2;
    }

    if str.capacity == new_capacity {
        return;
    }

    str.data = realloc(str.data, new_capacity + 1);
    str.capacity = new_capacity;

}

// Assign each character from one string into another.
#strings
assign_string(destination: &string, source: &string) {
    reserve_string(destination, source.length);
    copy_bytes(destination.data, source.data, source.length);
    destination.data[source.length] = '\0';
    destination.length = source.length;
}

// Assign each character from a buffer into a string, expands if needed.
#strings
assign_string_from_buffer(str: &string, buffer: &char, count: usize) {
    reserve_string(str, count);
    copy_bytes(str.data, buffer, count);
    str.length = count;
    str.data[count] = '\0';
}

// Append one string onto another.
#strings
append_string(destination: &string, source: &string) {
    new_length: usize = destination.length + source.length;
    reserve_string(destination, new_length);

    j: usize = destination.length;

    for i := 0..source.length {
        destination.data[j] = source.data[i];
        j += 1;
    }

    destination.data[j] = '\0';
    destination.length = new_length;
}

// Append a range of characters from one string onto another.
#strings
append_string_slice(destination: &string, source: &string, start: usize, end: usize) {
    if source.length == 0 || start > destination.length || start > end {
        return;
    }

    diff := end - start;
    new_len := destination.length + diff;
    reserve_string(destination, new_len);
    copy_bytes(cast(&char destination.data + destination.length), cast(&char source.data + start), diff);
    destination.length = new_len;
    destination.data[new_len] = '\0';
}

// Push a character into a string, at a given index or onto the end.
#strings
push_string_char(str: &string, c: char, index: isize = -1) {
    if index < -1 || index > str.length {
        return;
    }

    if index == -1 {
        index = str.length;
    }

    reserve_string(str, str.length + 1);
    start: usize = str.length + 1;

    for rev i: usize = start..index {
        str.data[i] = str.data[i - 1];
    }

    str.data[index] = c;
    str.length += 1;
    str.data[str.length] = '\0';
}

// Pop a character from a string, from a given index or from the end.
#strings
pop_string_char(str: &string, index: isize = -1): char {
    if str.length == 0 || index > str.length || index < -1 {
        return 0;
    }

    if index < 0 {
        index = str.length - 1;
    }

    popped := str.data[index];
    last: usize = str.length - 1;

    for i: usize = index..last {
        str.data[i] = str.data[i + 1];
    }

    str.length -= 1;
    str.data[str.length] = '\0';
    return popped;
}

// Insert a string into another string at an index.
#strings
insert_string(destination: &string, source: &string, index: usize, remove_index_char: bool = false) {
    dst_len := destination.length;

    if index > dst_len {
        return;
    }

    src_len := source.length;

    if src_len == 0 {
        return;
    }

    total_len := dst_len + src_len;
    reserve_string(destination, total_len);

    slice: &string;

    if remove_index_char {
        slice = copy_string_slice(destination, index + 1, dst_len);
    } else {
        slice = copy_string_slice(destination, index, dst_len);
    }

    destination.length -= dst_len - index;

    for i := 0..src_len {
        destination.data[index + i] = source.data[i];
    }

    destination.length += src_len;
    append_string(destination, slice);
    delete_string(slice);
    destination.length = total_len;
    destination.data[total_len] = '\0';
}

// Assuming the destination string already has enough memory allocated, replaces each '%' character with the given string arguments according to the format string. Use '/%' together to insert a single percent sign and not a replacement specifier.
#strings
format_string(destination: &string, format: &string, s1: &string, s2: &string, s3: &string, s4: &string) {
    assign_string(destination, format);
    format_len := format.length;

    if format_len == 0 || s1 == null {
        return;
    }

    arg_count := 1;

    if s2 != null {
        arg_count += 1;

        if s3 != null {
            arg_count += 1;

            if s4 != null {
                arg_count += 1;
            }
        }
    }

    specifier_count := 0;

    for i1 := 0..format_len {
        if format.data[i1] != '%' {
            continue;
        }

        if i1 > 0 && format.data[i1 - 1] == '/' {
            continue;
        }

        specifier_count += 1;
    }

    replacement: &string;
    args_replaced := 0;

    for i := 0..destination.length {
        if args_replaced == arg_count || args_replaced == specifier_count {
            break;
        }

        if destination.data[i] != '%' {
            continue;
        }

        if i > 0 && destination.data[i - 1] == '/' {
            continue;
        }

        if args_replaced == 0 {
            replacement = s1;
        } else if args_replaced == 1 {
            replacement = s2;
        } else if args_replaced == 2 {
            replacement = s3;
        } else {
            replacement = s4;
        }

        insert_string(destination, replacement, i, true);
        i += replacement.length;
        args_replaced += 1;
    }
}


// Find the first occurence of a character in a string. May return -1 on failure.
#strings
find_string_char(str: &string, c: char, start: usize = 0): isize {
    len := str.length;

    if start >= len {
        return -1;
    }

    for i := start..len {
        if str.data[i] == c {
            return i;
        }
    }

    return -1;
}

// Find the last occurence of a character in a string. May return -1 on failure.
#strings
find_last_string_char(str: &string, c: char, start: isize = -1): isize {
    len := str.length;

    if start >= len {
        return -1;
    }

    if start == -1 {
        start = len - 1;
    } else if start < -1 {
        return -1;
    }

    for rev i := start..=0 {
        if str.data[i] == c {
            return i;
        }
    }

    return -1;
}

// Count all occurrences of a character in a string.
#strings
count_string_char(str: &string, c: char, start: usize = 0): u32 {
    len := str.length;

    if start >= len || str.length == 0 {
        return 0;
    }

    count: u32 = 0;

    for i := start..len {
        if str.data[i] == c {
            count += 1;
        }
    }
    
    return count;
}

// Find the first occurence of a string in another string. May return -1 on failure.
#strings
find_substring(haystack: &string, needle: &string, start: usize = 0): isize {
    haystack_len := haystack.length;
    needle_len := needle.length;

    if haystack_len == 0 || needle_len == 0 || start >= haystack_len {
        return -1;
    }

    haystack_index: usize = 0;
    needle_index: usize = 0;

    while needle_index < needle_len && haystack_index < haystack_len {
        if haystack.data[start + haystack_index] == needle.data[needle_index] {
            needle_index += 1;
        }

        haystack_index += 1;

        if needle_index == needle_len {
            return haystack_index - needle_len;
        }
    }

    return -1;
}

// Reverse the order of characters in a string.
#strings
reverse_string(str: &string) {
    if str.length <= 1 {
        return;
    }

    count: usize = str.length - 1;
    start: usize = 0;
    temp: char;

    while start < count {
        temp = str.data[start];
        str.data[start] = str.data[count];
        str.data[count] = temp;

        start += 1;
        count -= 1;
    }
}

// Allocate a new string and copy a cstring into it.
#strings
buffer_to_string(buffer: &char): &string {
    len := buffer_length(buffer);
    str: &string = new_string(len + 1);
    assign_string_from_buffer(str, buffer, len);
    return str;
}

// Find the length of a char buffer.
#strings
buffer_length(buffer: &char): usize {
    len: usize = 0;

    while buffer[len] != '\0' {
        len += 1;
    }

    return len;

}

// Allocate a new string and convert an integer into a string.
#strings
int_to_string(number: i64, buffer: &string = null, base: u32 = 10): &string {
    str: &string = new_string(INT_BUFFER_CAPACITY);
    len: usize = 0;
    is_negative: bool = false;

    if number == 0 {
        str.data[0] = '0';
        str.data[1] = '\0';
        str.length = 1;
        return str;
    }

    if number < 0 {
        is_negative = true;
        number = -number;
    }

    while number != 0 {
        str.data[len] = number % base + '0';
        len += 1;
        number /= base;
    }

    if is_negative {
        str.data[len] = '-';
        len += 1;
    }

    str.data[len] = '\0';
    str.length = len;
    reverse_string(str);
    return str;
}

// Convert a '0x' prefixed string to an integer. Will return -1 on failure.
hex_prefixed_string_to_int(str: &string, i: usize): i64 {
    result: i64 = 0;
    len: usize = str.length;

    while i < len {
        b: byte = str.data[i];

        if b >= '0' && b <= '9' {
            b = b - '0';
        } else if b >= 'a' && b <= 'z' {
            b = b - 'a' + 10;
        } else if b >= 'A' && b <= 'Z' {
            b = b - 'A' + 10;
        } else {
            return -1;
        }

        result = (result << 4) | (b & 0xF);
        i += 1;
    }

    return result;
}

// Convert a string to an integer. May return -1 on failure.
#strings
string_to_int(str: &string): i64 {
    i: usize = 0;

    while is_whitespace(str.data[i]) {
        i += 1;
    }

    if i == str.length {
        return -1;
    }

    if str.length > i + 1 && str.data[i] == '0' && to_lower(str.data[i + 1]) == 'x' {
        return hex_prefixed_string_to_int(str, i + 2);
    }

    base: u32 = 10;
    ignore_last_char := false; // In case of suffixes like 'h' or 'o'.

    if to_lower(str.data[str.length - 1]) == 'o' {
        base = 8;
        ignore_last_char = true;
    } else if to_lower(str.data[str.length - 1]) == 'h' {
        base = 16;
        ignore_last_char = true;
    }

    is_negative := false;

    if str.data[i] == '+' {
        i += 1;
    } else if str.data[i] == '-' {
        is_negative = true;
        i += 1;
    }

    result: i64 = 0;
    len: usize = str.length;
    
    if ignore_last_char {
        len -= 1;
    }

    while i < len {
        result = result * base + str.data[i] - '0';
        i += 1;
    }

    if is_negative {
        result = -result;
    }

    return result;
}

// Allocate a new string and convert a floating-point into a string.
#strings
float_to_string(number: f64, decimal_points: u32 = 2): &string {
    mantissa: i64 = number;
    str := int_to_string(mantissa);

    if decimal_points <= 0 {
        return str;
    }

    len := str.length;

    if len + decimal_points > str.capacity {
        new_size: usize = len + decimal_points + 1;
        str = realloc(str, new_size);
        str.capacity = new_size;
    }

    if number < 0 {
        number = -number;
        mantissa = -mantissa;
    }

    str.data[len] = '.';
    len += 1;

    exponent: f64 = number - mantissa;


    //if decimal_points > 3 {
      //  exponent -= FLOAT_EPSILON_TOLERANCE;
    //}

    for i := 0..decimal_points {
        exponent *= 10;
        str.data[len] = cast(i64 exponent) + '0';

        len += 1;
        exponent -= cast(i64 exponent);
    }

    str.data[len] = '\0';
    str.length = len;
    return str;
}

// Check if a character is part of the alphabet.
#strings
is_alphabetical(c: char): bool {
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z');
}

// Check if a character is a number.
#strings
is_numerical(c: char): bool {
    return c >= '0' && c <= '9';
}

// Check if a character is a whitespace character (space, tab, newline or carriage return).
#strings
is_whitespace(c: char): bool {
    return c == ' ' || c == '\n' || c == '\t' || c == '\r';
}

// Convert an uppercase alphabetical character to lowercase, unless already lowercase or not alphabetical.
#strings
to_lower(c: char): char {
    if c >= 'A' && c <= 'Z' {
        return c - 48;
    }

    return c;
}

// Convert a lowercase alphabetical character to uppercase, unless already uppercase or not alphabetical.
#strings
to_upper(c: char): char {
    if c >= 'a' && c <= 'z' {
        return c + 48;
    }

    return c;
}

// Open a new file descriptor.
#io
open_file(name: &string, mode: char): File {
    flags: u32;

    if mode == 'w' {
        flags = system.O_RDWR | system.O_CREAT;
    } else if mode == 'a' {
        flags = system.O_APPEND | system.O_CREAT;
    } else if mode == 'r' {
        flags = system.O_RDONLY;
    }

    return system.open(name.data, flags, 644o);
}

// Close a file descriptor.
#io
close_file(file: File): bool {
    return system.close(file) == 0;
}

// Write to a file descriptor.
#io
write_file(file: File, text: &string): bool {
    return system.write(file, text.data, text.length) > -1;
}

// Read from a file descriptor.
#io
read_file(file: File, buffer: &char, capacity: usize): bool {
    return system.read(file, buffer, capacity) > -1;
}

// Create a new file. Returns a negative number on failure.
#io
create_file(path: &string): File {
    return system.creat(path.data, 644o);
}

// Create a new directory.
#io
create_directory(path: &string): bool {
    return system.mkdir(path.data) == 0;
}

// Remove a file.
#io
remove_file(path: &string): bool {
    return system.unlink(path.data) == 0;
}

// Remove a directory.
#io
remove_directory(path: &string): bool {
    return system.rmdir(path.data) == 0;
}

// Set the allocation size of heap objects at chosen indexes.
set_heap_free_list_sizes(start_index: usize, value: usize, count: usize) {
    free_list := get_ki_heap_free_list();

    for i := 0..count {
        free_list[start_index + i] = value;
    }
}

// Allocate memory for the Ki heap.
#memory
__internal_allocate_heap() {
    set_ki_heap(system.mmap(null, HEAP_SIZE + GUARD_PAGE_SIZE, system.PROT_READ | system.PROT_WRITE,
        system.MAP_PRIVATE | system.MAP_ANONYMOUS, -1, 0));

    system.mprotect(cast(&void get_ki_heap() + HEAP_SIZE), GUARD_PAGE_SIZE, system.PROT_NONE);

    set_ki_heap_free_list(system.mmap(null, HEAP_SIZE * sizeof(usize), system.PROT_READ | system.PROT_WRITE,
        system.MAP_PRIVATE | system.MAP_ANONYMOUS, -1, 0));

    set_heap_free_list_sizes(0, 0, HEAP_SIZE);
}

// Free the memory from the Ki heap.
@omit_frame_pointer
#memory
__internal_free_heap() {
    system.munmap(get_ki_heap(), HEAP_SIZE + GUARD_PAGE_SIZE);
    system.munmap(get_ki_heap_free_list(), HEAP_SIZE * sizeof(usize));
}

// Get the heap allocation pointer.
@omit_frame_pointer
@ignore_missing_return
get_ki_heap(): &void {
    asm("mov rax, qword [_ki_heap]");
}

// Get the heap allocation pointer.
@omit_frame_pointer
@ignore_missing_return
get_ki_heap_pointer(): usize {
    asm("mov rax, qword [_ki_heap_ptr]");
}

// Get the heap free list.
@omit_frame_pointer
@ignore_missing_return
get_ki_heap_free_list(): &usize {
    asm("mov rax, qword [_ki_heap_free_list]");
}

// Get the heap allocation pointer.
@omit_frame_pointer
@onetime_arguments
set_ki_heap(value: &void) {
    asm("mov qword [_ki_heap], rdi");
}

// Get the heap allocation pointer.
@omit_frame_pointer
@onetime_arguments
set_ki_heap_pointer(value: usize) {
    asm("mov qword [_ki_heap_ptr], rdi");
}

// Get the heap allocation pointer.
@omit_frame_pointer
@onetime_arguments
set_ki_heap_free_list(value: &usize) {
    asm("mov qword [_ki_heap_free_list], rdi");
}

// Search for an empty space in the heap before the heap pointer that is big enough for the allocation size.
find_empty_space_before_heap_pointer(size: usize): &void {
    ptr := get_ki_heap_pointer();
    free_list := get_ki_heap_free_list();

    for i := 0..ptr {
        if free_list[i] > 0 {
            continue;
        }

        empty := true;

        for j := 0..size {
            if free_list[i + j] > 0 {
                empty = false;
                break;
            }
        }

        if empty {
            return &get_ki_heap()[i];
        }
    }

    return null;
}

// Allocate a portion of memory onto the heap and return the address.
#memory
alloc(size: usize): &void {
    space := find_empty_space_before_heap_pointer(size);
    index: usize;

    if space == null {
        index = get_ki_heap_pointer();
        space = &get_ki_heap()[index];
    } else {
        index = cast(usize space - get_ki_heap());
    }

    set_ki_heap_pointer(index + size);
    set_heap_free_list_sizes(index, size, size);
    return space;
}

// Free a portion of memory from the heap.
#memory
free(pointer: &void) {
    index: usize = cast(usize pointer - get_ki_heap());
    size: usize = get_ki_heap_free_list()[index];
    set_heap_free_list_sizes(index, 0, size);
}

// Copy the data from the old pointer into a new allocated pointer and free the old pointer.
#memory
realloc(old_pointer: &void, new_size: usize): &void {
    new_ptr := alloc(new_size);
    old_size := get_ki_heap_free_list()[cast(usize old_pointer - get_ki_heap())];
    copy_bytes(new_ptr, old_pointer, old_size);
    free(old_pointer);
    return new_ptr;
}

// Exit the program.
#debugging
exit(code: i32 = 0) {
    __internal_free_heap();
    system.exit(code);
}

// If the provided condition equates to false, print the error message and exit the program.
#debugging
assert(condition: bool, error_message: &string) {
    if condition {
        return;
    }

    print("assert failed: ");
    println(error_message);
    exit(EXIT_FAILURE);
}

// Return the absolute value of an integer.
#math
abs(x: i64): i64 {
    if x < 0 {
        return -x;
    }

    return x;
}

// Return the absolute value of a float.
#math
fabs(x: f64): f64 {
    if x < 0 {
        return -x;
    }

    return x;
}


